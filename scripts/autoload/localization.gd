func _ready() -> void:
	_register("ko", KO)


func _register(locale: String, table: Dictionary) -> void:
	var t := Translation.new()
	t.locale = locale
	for key in table:
		t.add_message(key, table[key])
	TranslationServer.add_translation(t)
